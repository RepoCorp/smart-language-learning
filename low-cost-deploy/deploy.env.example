AWS_REGION=us-east-1

# Frontend (Amplify + S3)
AMPLIFY_APP_ID=dp4u2ys65g8ep
AMPLIFY_BRANCH=prod
FRONTEND_BUCKET=www.welearnsmart.com
BACKEND_API_URL=https://api.welearnsmart.com/api

# Backend (Lightsail Containers)
LIGHTSAIL_SERVICE_NAME=welearnsmart-backend
LIGHTSAIL_IMAGE_LABEL=backend
LIGHTSAIL_CONTAINER_NAME=backend
LIGHTSAIL_CONTAINER_PORT=8000
LIGHTSAIL_HEALTH_CHECK_PATH=/api/health
# Migrations and seed loading run before Gunicorn starts. Allow 60 seconds for that normal startup work.
LIGHTSAIL_HEALTH_CHECK_HEALTHY_THRESHOLD=2
LIGHTSAIL_HEALTH_CHECK_UNHEALTHY_THRESHOLD=6
LIGHTSAIL_HEALTH_CHECK_TIMEOUT_SECONDS=5
LIGHTSAIL_HEALTH_CHECK_INTERVAL_SECONDS=10
BACKEND_IMAGE_NAME=welearnsmart-backend
BACKEND_IMAGE_TAG=lightsail
BACKEND_ENV_FILE=low-cost-deploy/backend.env
